# ===== 必須 =====
# Claude API キー（https://console.anthropic.com/）
ANTHROPIC_API_KEY=
# 言い換え・回答生成に使うモデル
ANTHROPIC_MODEL=claude-opus-5-5

# ===== 任意：判断特化モデル Jev（TypeSafe AI）=====
# 未設定なら関係判定・裏付け検証は Claude が代行します
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# チャンクを「関係あり」とみなす確率の下限（0〜1）
GRADE_THRESHOLD=0.6
# 回答を「裏付けあり」とみなす確率の下限（0〜1）
VERIFY_THRESHOLD=0.7
# false にすると verify ノードを素通りします
VERIFY_ENABLED=true

# ===== 検索・取り込み =====
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVE_K=8
# 取得したチャンクを同じページ全体に広げてから判定・回答する（スキャン資料の表で効く）
EXPAND_TO_PAGE=true
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ===== パス（通常は変更不要）=====
DOCS_DIR=docs
SAMPLE_DOCS_DIR=sample_docs
CHROMA_DIR=data/chroma
FASTEMBED_CACHE_PATH=data/fastembed_cache
